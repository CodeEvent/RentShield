PORT=4000
# Absolute path override for the SQLite file (defaults to api/data/rentshield.sqlite)
# RENTSHIELD_DB_PATH=/absolute/path/to/rentshield.sqlite

# Base URL of the ocr/ service (defaults to http://localhost:8001)
# OCR_SERVICE_URL=http://localhost:8001

# --- E-signature (Notarization Service add-on) — see api/src/services/esign/ ---
# Which provider handles a signing request first, and which is tried if
# that one is unreachable. Both must be self-hosted separately (docker/docker-compose.yml).
# ESIGN_PRIMARY=docuseal
# ESIGN_FALLBACK=opensign

# DocuSeal (https://github.com/docusealco/docuseal) — self-hosted instance URL
# and an API token generated from its own Settings -> API screen.
# DOCUSEAL_URL=http://localhost:3010
# DOCUSEAL_API_TOKEN=

# OpenSign (https://github.com/opensignlabs/OpenSign) — self-hosted server URL,
# the APP_ID/MASTER_KEY it was started with, and the Parse _User objectId of
# the service account documents should be created under (a one-time setup
# step: sign up a service account in the OpenSign UI once, then copy its
# objectId from the _User class in the Parse dashboard).
# OPENSIGN_URL=http://localhost:8081
# OPENSIGN_APP_ID=rentshield
# OPENSIGN_MASTER_KEY=
# OPENSIGN_SERVICE_USER_ID=
